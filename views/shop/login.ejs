
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop Owner Login | SHOPFLOW</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/shop-login.css">
</head>

<body>

<div class="login-layout">

    <!-- Left Branding Panel -->
    <section class="brand-panel">

        <div class="brand-content">

            <a href="/" class="brand-logo">
                <div class="logo-icon">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <span>SHOPFLOW</span>
            </a>

            <div class="brand-message">
                <span class="brand-tag">
                    <i class="fa-solid fa-sparkles"></i>
                    SMART BUSINESS MANAGEMENT
                </span>

                <h1>
                    Your business.<br>
                    Your control.<br>
                    <span>One platform.</span>
                </h1>

                <p>
                    Manage products, track sales, handle billing and understand
                    your business growth — all from one powerful workspace.
                </p>

                <div class="feature-list">

                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="fa-solid fa-receipt"></i>
                        </div>
                        <div>
                            <strong>Smart Digital Billing</strong>
                            <span>Create and manage bills effortlessly.</span>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </div>
                        <div>
                            <strong>Inventory Management</strong>
                            <span>Keep your product stock organized.</span>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>
                        <div>
                            <strong>Business Insights</strong>
                            <span>Understand sales and business performance.</span>
                        </div>
                    </div>

                </div>
            </div>

            <div class="brand-footer">
                <span>© <%= new Date().getFullYear() %> SHOPFLOW</span>
                <span>Built for smarter businesses.</span>
            </div>

        </div>

        <div class="decor-circle circle-one"></div>
        <div class="decor-circle circle-two"></div>
        <div class="decor-grid"></div>

    </section>

    <!-- Right Login Panel -->
    <main class="login-panel">

        <div class="login-wrapper">

            <div class="mobile-logo">
                <div class="logo-icon">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <span>SHOPFLOW</span>
            </div>

            <div class="login-heading">
                <div class="welcome-icon">
                    <i class="fa-solid fa-user-lock"></i>
                </div>

                <span class="welcome-label">SHOP OWNER PORTAL</span>

                <h2>Welcome back!</h2>

                <p>Enter your credentials to access your shop workspace.</p>
            </div>

            <% if (error) { %>
                <div class="login-error" role="alert">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/shop/login" method="POST" id="loginForm">

                <div class="form-group">
                    <label for="login_id">Login ID</label>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-user input-icon"></i>

                        <input
                            type="text"
                            id="login_id"
                            name="login_id"
                            placeholder="Enter your username"
                            autocomplete="username"
                            required
                        >
                    </div>
                </div>

                <div class="form-group">
                    <div class="password-label">
                        <label for="password">Password</label>
                        <span>Keep your credentials secure</span>
                    </div>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-lock input-icon"></i>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required
                        >

                        <button type="button" class="password-toggle" id="togglePassword" aria-label="Show password">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="login-button" id="loginButton">
                    <span>Login to Shop</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>

            </form>

            <div class="security-note">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Your shop account is protected with secure authentication.</span>
            </div>

            <div class="login-bottom">
                <span>Need access to your shop?</span>
                <p>Contact your SHOPFLOW platform administrator.</p>
            </div>

        </div>

    </main>

</div>

<script src="/js/shop-login.js"></script>

</body>
</html>
