<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Invoice #<%= bill.bill_id %> - <%= shopName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body { background: white; }
            no-print { display: none; }
            .shadow { box-shadow: none !important; }
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen py-8">
    <div class="max-w-2xl mx-auto">
        <!-- Action Buttons (No Print) -->
        <div class="no-print flex justify-between items-center mb-6 px-4">
            <a href="/shop/billing" class="text-sm bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700">← Back to Billing</a>
            <div class="flex gap-2">
                <% if (bill.mobile) { %>
                    <% 
                        const waMsg = encodeURIComponent(
                            `Hello *${bill.cust_name || 'Customer'}*,\n\nHere is your digital invoice from *${bill.shop_name}*:\nBill ID: #${bill.bill_id}\nTotal Amount: ₹${bill.final_amount}\nPayment Status: ${bill.payment_status}\n\nThank you for shopping with us!`
                        );
                        const cleanPhone = bill.mobile.replace(/\D/g, '');
                    %>
                    <a href="https://wa.me/<%= cleanPhone %>?text=<%= waMsg %>" target="_blank" class="bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-green-700">
                        💬 Share on WhatsApp
                    </a>
                <% } %>
                <button onclick="window.print()" class="bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-indigo-700">
                    🖨️ Print / Download PDF
                </button>
            </div>
        </div>

        <% if (success) { %>
            <div class="no-print bg-green-100 text-green-700 p-3 rounded mb-4 text-sm mx-4"><%= success %></div>
        <% } %>

        <!-- Invoice Card -->
        <div class="bg-white p-8 rounded-lg shadow mx-4">
            <div class="flex justify-between border-b pb-6 mb-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-800"><%= bill.shop_name %></h1>
                    <p class="text-xs text-gray-500 mt-1"><%= bill.shop_address || '' %> (<%= bill.area %>)</p>
                    <p class="text-xs text-gray-500">Contact: <%= bill.contact_number %></p>
                </div>
                <div class="text-right">
                    <h2 class="text-xl font-bold text-indigo-600">INVOICE</h2>
                    <p class="text-sm font-semibold text-gray-700">Bill ID: #<%= bill.bill_id %></p>
                    <p class="text-xs text-gray-500">Date: <%= bill.created_at.split('T')[0] %></p>
                </div>
            </div>

            <!-- Customer Details -->
            <div class="bg-gray-50 p-4 rounded-lg mb-6 text-sm">
                <p class="font-bold text-gray-700">Customer Details:</p>
                <p>Name: <span class="font-semibold"><%= bill.cust_name || 'Walk-in Customer' %></span></p>
                <p>Mobile: <span class="font-semibold"><%= bill.mobile || 'N/A' %></span></p>
            </div>

            <!-- Items Table -->
            <table class="w-full text-left border-collapse mb-6">
                <thead>
                    <tr class="bg-gray-200 text-gray-700 text-xs">
                        <th class="p-3">Product Name</th>
                        <th class="p-3">Size/Color</th>
                        <th class="p-3">Price</th>
                        <th class="p-3">Qty</th>
                        <th class="p-3 text-right">Subtotal</th>
                    </tr>
                </thead>
                <tbody class="text-gray-600 text-xs divide-y divide-gray-200">
                    <% items.forEach(item => { %>
                        <tr>
                            <td class="p-3 font-medium text-gray-800"><%= item.product_name %></td>
                            <td class="p-3"><%= item.product_size || '-' %> / <%= item.product_color || '-' %></td>
                            <td class="p-3">₹<%= item.price %></td>
                            <td class="p-3"><%= item.quantity %></td>
                            <td class="p-3 text-right font-semibold">₹<%= item.subtotal %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <!-- Totals -->
            <div class="flex justify-end border-t pt-4">
                <div class="w-64 space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-gray-500">Subtotal:</span>
                        <span class="font-semibold">₹<%= bill.total_amount %></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-500">Discount:</span>
                        <span class="font-semibold text-red-500">-₹<%= bill.discount %></span>
                    </div>
                    <div class="flex justify-between border-t pt-2 text-base font-bold text-gray-800">
                        <span>Final Payable:</span>
                        <span class="text-indigo-600">₹<%= bill.final_amount %></span>
                    </div>
                    <div class="flex justify-between text-xs pt-1">
                        <span class="text-gray-500">Payment Status:</span>
                        <span class="px-2 py-0.5 rounded font-bold <%= bill.payment_status === 'PAID' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>"><%= bill.payment_status %></span>
                    </div>
                </div>
            </div>

            <div class="border-t mt-8 pt-6 text-center text-xs text-gray-400">
                <p>Thank you for shopping with us! Please visit again.</p>
            </div>
        </div>
    </div>
</body>
</html>