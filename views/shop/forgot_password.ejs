<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Forgot Password - Shop Owner</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center h-screen">
    <div class="bg-white p-8 rounded-lg shadow-md w-96">
        <h2 class="text-2xl font-bold mb-2 text-center text-gray-800">Forgot Password</h2>
        <p class="text-gray-500 text-xs text-center mb-6">Enter your Login ID to get WhatsApp reset link.</p>

        <% if (error) { %>
            <div class="bg-red-100 text-red-700 p-3 rounded mb-4 text-sm"><%= error %></div>
        <% } %>
        <% if (success) { %>
            <div class="bg-green-100 text-green-700 p-3 rounded mb-4 text-sm"><%= success %></div>
            <% if (whatsappLink) { %>
                <div class="mb-4">
                    <a href="<%= whatsappLink %>" target="_blank" class="block text-center bg-green-500 text-white py-2 px-4 rounded-lg hover:bg-green-600 transition font-semibold text-sm">
                        💬 Send Reset Link via WhatsApp
                    </a>
                </div>
            <% } %>
        <% } %>

        <form action="/shop/forgot-password" method="POST">
            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2">Login ID (Username)</label>
                <input type="text" name="login_id" required class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
            </div>
            <button type="submit" class="w-full bg-indigo-600 text-white py-2 rounded-lg hover:bg-indigo-700 transition font-semibold text-sm mb-4">Generate Reset Link</button>
        </form>

        <div class="text-center">
            <a href="/shop/login" class="text-xs text-indigo-600 hover:underline">Back to Login</a>
        </div>
    </div>
</body>
</html>