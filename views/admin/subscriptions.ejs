<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Subscription Management - SaaS Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
    <nav class="bg-blue-600 text-white px-6 py-4 flex justify-between items-center shadow-md">
        <h1 class="text-xl font-bold">SaaS Admin Panel</h1>
        <div class="flex items-center gap-4">
            <a href="/admin/dashboard" class="hover:underline">Dashboard</a>
            <a href="/admin/shops" class="hover:underline">Shops</a>
            <a href="/admin/subscriptions" class="underline font-semibold">Subscriptions</a>
            <a href="/admin/logout" class="bg-red-500 px-3 py-1 rounded text-sm hover:bg-red-600">Logout</a>
        </div>
    </nav>

    <div class="container mx-auto px-6 py-8">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-semibold text-gray-800">Subscription & Plan Management</h2>
            <div class="flex gap-3">
                <a href="/admin/subscriptions/assign" class="bg-green-600 text-white px-4 py-2 rounded-lg shadow hover:bg-green-700 transition">+ Assign Plan to Shop</a>
            </div>
        </div>

        <% if (success) { %>
            <div class="bg-green-100 text-green-700 p-3 rounded mb-4 text-sm"><%= success %></div>
        <% } %>
        <% if (error) { %>
            <div class="bg-red-100 text-red-700 p-3 rounded mb-4 text-sm"><%= error %></div>
        <% } %>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <!-- Create Plan Form Card -->
            <div class="bg-white p-6 rounded-lg shadow md:col-span-1">
                <h3 class="text-lg font-bold text-gray-800 mb-4">Create New Plan</h3>
                <form action="/admin/subscriptions/plans/new" method="POST" class="space-y-4">
                    <div>
                        <label class="block text-gray-700 text-sm font-bold mb-1">Plan Name</label>
                        <input type="text" name="plan_name" required placeholder="e.g. 60-Day Standard Plan" class="w-full px-3 py-2 border rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-gray-700 text-sm font-bold mb-1">Price (₹)</label>
                        <input type="number" name="plan_price" required placeholder="999" class="w-full px-3 py-2 border rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-gray-700 text-sm font-bold mb-1">Duration (Days)</label>
                        <input type="number" name="duration_days" required value="60" class="w-full px-3 py-2 border rounded-lg text-sm">
                    </div>
                    <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition text-sm font-semibold">Create Plan</button>
                </form>

                <hr class="my-6">

                <h4 class="font-bold text-gray-700 text-sm mb-2">Existing Plans</h4>
                <div class="space-y-2">
                    <% plans.forEach(plan => { %>
                        <div class="bg-gray-50 p-3 rounded border text-xs flex justify-between items-center">
                            <div>
                                <p class="font-semibold text-gray-800"><%= plan.plan_name %></p>
                                <p class="text-gray-500">₹<%= plan.plan_price %> / <%= plan.duration_days %> Days</p>
                            </div>
                            <span class="px-2 py-0.5 bg-blue-100 text-blue-700 rounded"><%= plan.plan_status %></span>
                        </div>
                    <% }) %>
                </div>
            </div>

            <!-- Active Subscriptions Table -->
            <div class="bg-white p-6 rounded-lg shadow md:col-span-2 overflow-hidden">
                <h3 class="text-lg font-bold text-gray-800 mb-4">Shop Subscriptions History</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-200 text-gray-700 text-xs">
                                <th class="p-2.5">Shop Name</th>
                                <th class="p-2.5">Plan</th>
                                <th class="p-2.5">Start Date</th>
                                <th class="p-2.5">Expiry Date</th>
                                <th class="p-2.5">Paid</th>
                                <th class="p-2.5">Status</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-600 text-xs divide-y divide-gray-200">
                            <% if (subscriptions.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="p-4 text-center text-gray-400">No active subscriptions found.</td>
                                </tr>
                            <% } else { %>
                                <% subscriptions.forEach(sub => { %>
                                    <tr>
                                        <td class="p-2.5 font-medium text-gray-800"><%= sub.shop_name %></td>
                                        <td class="p-2.5"><%= sub.plan_name %></td>
                                        <td class="p-2.5"><%= sub.start_date %></td>
                                        <td class="p-2.5 font-semibold text-red-600"><%= sub.expiry_date %></td>
                                        <td class="p-2.5">₹<%= sub.amount_paid %></td>
                                        <td class="p-2.5">
                                            <span class="px-2 py-0.5 rounded font-semibold 
                                                <%= sub.subscription_status === 'ACTIVE' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                                                <%= sub.subscription_status %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>